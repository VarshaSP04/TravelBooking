<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Travel Booking Website</display-name>
    <description>A full-stack travel booking platform</description>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <!-- Session Config: 30 min timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ======================== LISTENERS ======================== -->

    <listener>
        <listener-class>com.travelbooking.listener.AppStartupListener</listener-class>
    </listener>

    <!-- ======================== FILTERS ======================== -->

    <!-- Auth Filter: protects user routes -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.travelbooking.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/dashboard/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/booking/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/profile/*</url-pattern>
    </filter-mapping>

    <!-- Admin Auth Filter: protects admin routes -->
    <filter>
        <filter-name>AdminAuthFilter</filter-name>
        <filter-class>com.travelbooking.filter.AdminAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- ======================== SERVLETS ======================== -->

    <!-- Public Servlets -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HotelServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.HotelServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HotelServlet</servlet-name>
        <url-pattern>/hotels</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HotelServlet</servlet-name>
        <url-pattern>/hotel</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TripServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.TripServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TripServlet</servlet-name>
        <url-pattern>/trips</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TripServlet</servlet-name>
        <url-pattern>/trip</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FlightServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.FlightServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FlightServlet</servlet-name>
        <url-pattern>/flights</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FlightServlet</servlet-name>
        <url-pattern>/flight</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TrainServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.TrainServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TrainServlet</servlet-name>
        <url-pattern>/trains</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TrainServlet</servlet-name>
        <url-pattern>/train</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SearchServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.SearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>

    <!-- Protected User Servlets -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookingServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.BookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingServlet</servlet-name>
        <url-pattern>/booking</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookingServlet</servlet-name>
        <url-pattern>/booking/history</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlets -->
    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.admin.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/admin/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.admin.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminHotelServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.admin.AdminHotelServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminHotelServlet</servlet-name>
        <url-pattern>/admin/hotels</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminTripServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.admin.AdminTripServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminTripServlet</servlet-name>
        <url-pattern>/admin/trips</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.admin.AdminUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminBookingServlet</servlet-name>
        <servlet-class>com.travelbooking.controller.admin.AdminBookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminBookingServlet</servlet-name>
        <url-pattern>/admin/bookings</url-pattern>
    </servlet-mapping>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
</web-app>
